# ─────────────────────────────────────────────────────────────────────────────
# LogiSyncPRO APK Backend — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# USAGE: Copy this file to .env and fill in the real values.
# NEVER commit .env to Git. It contains secrets.
# On Render/Railway: set these as environment variables in the hosting dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon PostgreSQL (Android APK dedicated database) ─────────────────────────
# Get from: https://console.neon.tech → Your Project → Connection Details
# Use the POOLED connection string (port 5432, -pooler suffix in hostname)
DATABASE_URL=postgresql://USERNAME:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/logisync_apk_db?sslmode=require

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5050

# ── Firebase Project ──────────────────────────────────────────────────────────
# Found in: Firebase Console → Project Settings → General → Project ID
FIREBASE_PROJECT_ID=logisyncgdg

# ── Google OAuth Web Client ID ────────────────────────────────────────────────
# Found in: Firebase Console → Authentication → Sign-in method → Google → Web Client ID
# This is the same client_id in google-services.json (client_type: 3)
GOOGLE_CLIENT_ID=58479456655-h3mulvb8hb9r3fidtfa85qjecbjks7so.apps.googleusercontent.com

# ── Firebase Admin SDK Service Account (REQUIRED for token verification) ──────
# HOW TO GET:
#   1. Go to: https://console.firebase.google.com/project/logisyncgdg/settings/serviceaccounts/adminsdk
#   2. Click "Generate new private key" → Download JSON
#   3. Paste the ENTIRE JSON content as a single line in the value below
#   4. On Render: Set as "FIREBASE_SERVICE_ACCOUNT_JSON" environment variable in dashboard
# SECURITY: NEVER commit this value to git. It is a secret.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"logisyncgdg",...}

